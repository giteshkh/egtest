# BrowserStack credentials (copy this file to .env; .env is git-ignored)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# App under test (bs:// url shown after upload)
BS_APP_ID=bs://<app-id>
BUILD_NUMBER=local

# Customer POS tests only (test/specs/customer-complete-flow.spec.js)
TEST_SECONDARY_USERNAME=
TEST_SECONDARY_PASSWORD=
FS_UNLOCK_NAME=
FS_UNLOCK_PIN=
